{
  "name": "lab5-web-nestjs",
  "version": "1.0.0",
  "private": true,
  "description": "Практична робота №5: модулі та ін'єкція залежностей у NestJS (варіант 3)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
