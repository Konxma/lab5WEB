@baseUrl = http://localhost:3000

### Початкові гаджети після OnModuleInit
GET {{baseUrl}}/gadgets

### Пошук і обмеження видачі з практичної №4
GET {{baseUrl}}/gadgets?search=Pro&limit=1

### Отримати гаджет за ID
GET {{baseUrl}}/gadgets/1

### Неіснуючий ID: 404
GET {{baseUrl}}/gadgets/99999

### Створити гаджет із полями практичної №4
POST {{baseUrl}}/gadgets
Content-Type: application/json

{
  "title": "Новий Смартфон",
  "price": 30000,
  "warrantyMonths": 12,
  "cpu": "Snapdragon 8 Gen 3",
  "ramGb": 12
}

### Часткове оновлення
PATCH {{baseUrl}}/gadgets/3
Content-Type: application/json

{
  "title": "Смартфон Pro",
  "price": 42000
}

### Замовлення нового гаджета
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": "3",
  "quantity": 2,
  "customerEmail": "student@example.com"
}

### Невідомий гаджет у замовленні: 404
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": "99999",
  "quantity": 1,
  "customerEmail": "student@example.com"
}

### Список замовлень
GET {{baseUrl}}/orders

### Видалення гаджета: 204
DELETE {{baseUrl}}/gadgets/3
